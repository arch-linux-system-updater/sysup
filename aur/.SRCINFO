pkgbase = sysup
	pkgdesc = One command to update and tidy up your whole Arch system: pacman, AUR, Flatpak, firmware, dev tools, dotfiles, junk cleanup
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/arch-linux-system-updater/sysup
	arch = any
	license = MIT
	depends = bash
	depends = pacman
	depends = pacman-contrib
	depends = curl
	depends = coreutils
	depends = util-linux
	depends = findutils
	depends = grep
	depends = sed
	depends = gawk
	depends = procps-ng
	depends = systemd
	optdepends = sudo: run system-wide steps as a normal user (or doas / run0)
	optdepends = paru: AUR updates (recommended)
	optdepends = yay: AUR updates
	optdepends = flatpak: update Flatpak apps
	optdepends = fwupd: firmware updates
	optdepends = reflector: keep the mirrorlist fresh
	optdepends = rate-mirrors: keep the mirrorlist fresh (faster alternative to reflector)
	optdepends = rebuild-detector: find AUR packages that need a rebuild after library updates
	backup = etc/sysup.conf
	source = sysup-1.0.0.tar.gz::https://github.com/arch-linux-system-updater/sysup/archive/refs/tags/v1.0.0.tar.gz
